+    results, rows = {}, []
+    for rate in rates:
+        rng = np.random.default_rng(seed)               # the same seed for every rate: the draws of inputs are common, only the discounting differs
+        sims = {s: simulate(s, specs[s], rate, draws, rng) for s in STAGES}
+        cent = {s: simulate(s, specs[s], rate, 1, None) for s in STAGES}
+        port = {k: sum(sims[s][k] for s in STAGES) for k in ("registrants", "revenue_pv", "cost", "npv")}
+        port["roi"] = port["revenue_pv"] / port["cost"]
+        pc = {k: float(sum(cent[s][k][0] for s in STAGES)) for k in ("registrants", "revenue_pv", "cost", "npv")}
+        pc["roi"] = pc["revenue_pv"] / pc["cost"]
+        results[rate] = {"stages": {s: {"central": {k: float(v[0]) for k, v in cent[s].items()}, **{k: _summ(v) for k, v in sims[s].items()}} for s in STAGES},
+                         "portfolio": {"central": pc, **{k: _summ(v) for k, v in port.items()}}}
