+  label_search_terms: ['\btax', '\bTIN\b', '\bTRA\b', 'revenue authority', 'registration', 'registered', 'licen[cs]e', 'permit', '\bVAT\b', 'receipt', 'identity', 'national id', 'passport', 'voter', 'pay ?slip', 'invoice', 'ledger', 'bookkeep', 'record']
+  bootstrap_replicates: 500
+  scoring_card_C: 1.0
+  feature_rules:
+    max_levels: 30                   # categorical columns with more levels are excluded (free-form / codes)
+    min_level_share: 0.005           # levels held by under 0.5% of respondents get no indicator
+    constant_share: 0.995            # near-constant columns are excluded
+    max_single_feature_auc: 0.90     # a single feature with weighted AUC above this is treated as mechanically tied to the outcome
+  agent_age_bands: [[16, 24], [25, 34], [35, 44], [45, 54], [55, 64], [65, 90]]
 
