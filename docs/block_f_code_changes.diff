+
+  pit(income)                resident individual income tax on annual income (Income Tax Act Cap. 332 R.E. 2023, First Schedule para 1(1); unchanged by the Finance Acts
+                             2024, 2025 and 2026: config.yaml assumptions tax.pit_schedule)
+  presumptive(turnover)      presumptive income tax of an individual with turnover up to the ceiling (First Schedule para 2(3), as amended by the Finance Act 2026, in force from
+                             1 July 2026: ceiling TZS 200 million, 4.0% above TZS 11 million; config.yaml assumptions tax.presumptive_schedule)
+  owner_tax(turnover, net)   the tax of a business owner: presumptive tax on turnover up to the ceiling, income tax on net annual earnings above it
+
+Schedule year used by every output: the schedule in force in 2026/27 (resident schedule of the R.E. 2023 text, presumptive schedule of the Finance Act 2026). The ILFS earnings are 2024
+values in TZS and are not inflated; the thresholds are not indexed. The Finance Act 2026's twelve-month holiday for individuals who obtain a TIN to start a business (para 2(3) item 2 of
+the new table) is NOT applied: the registrants modelled are existing informal workers and owners, not new businesses; Table 40 reports it as a sensitivity.
+
+The mean tax of a group is computed from AGGREGATE QUANTILE CELLS of the earnings distribution (data/processed/twin_inputs.json `tax_base_cells`: 100 weighted cells of the
+group, each with the mean of the earnings variables of the respondents in it): the schedule is applied to every cell, so the tax follows the distribution and not its mean.
+"""
+
+import json
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths
+from assumptions import A
+
+
+def pit(income):
+    """Resident individual income tax (annual) on annual income (array)."""
+    income = np.asarray(income, float)
+    tax = np.zeros_like(income, dtype=float)
+    for lo, base, rate in A("tax.pit_schedule"):
+        tax = np.where(income > lo, base + rate * (income - lo), tax)
+    return tax
+
+
+def presumptive(turnover):
+    """Presumptive income tax, records kept (First Schedule para 2(3)); above the ceiling the individual schedule is applied to the turnover (callers use owner_tax instead)."""
+    spec = A("tax.presumptive_schedule")
+    t = np.asarray(turnover, float)
+    out = np.zeros_like(t)
+    for lo, hi, fixed, base, rate in spec["bands"]:
+        out = np.where((t > lo) & (t <= hi), base + rate * (t - lo), out)
+    out = np.where((t > spec["bands"][-1][1]) & (t <= spec["threshold_turnover"]), spec["above_11m_rate"] * t, out)
+    return np.where(t > spec["threshold_turnover"], pit(t), out)
+
+
+def owner_tax(turnover, net_earnings):
+    """Tax of a business owner: presumptive tax on turnover up to the ceiling, income tax on net annual earnings above it."""
+    turnover, net_earnings = np.asarray(turnover, float), np.asarray(net_earnings, float)
+    return np.where(turnover <= A("tax.presumptive_schedule")["threshold_turnover"], presumptive(turnover), pit(net_earnings))
+
+
+_CELLS = {}
+
+
+def cells():
+    """The quantile cells of the earnings distributions (data/processed/twin_inputs.json)."""
+    if "x" not in _CELLS:
+        try:
+            with open(paths.TWIN_INPUTS, encoding="utf-8") as f:
+                _CELLS["x"] = json.load(f)["tax_base_cells"]
+        except FileNotFoundError:
+            raise SystemExit("%s is missing: run `python run_all.py --from-raw` (src/03_features/twin_inputs.py writes it)" % paths.TWIN_INPUTS) from None
+    return _CELLS["x"]
+
+
+def informal_mean_tax(scale=1.0, c=None):
+    """Mean statutory tax per informal earner (ILFS 2024; informal employment, outside the formal net, positive earnings), earnings multiplied by `scale`: non-owners pay the resident
+    schedule on annual earnings, business owners the presumptive tax on turnover (income tax on net earnings above the ceiling)."""
+    c = c or cells()
+    non, own = c["informal_nonowner"], c["informal_owner"]
+    t_non = float(np.mean(pit(scale * np.array(non["annual_earnings"]))))
+    t_own = float(np.mean(owner_tax(scale * np.array(own["turnover"]), scale * np.array(own["net_earnings"]))))
+    return non["share"] * t_non + own["share"] * t_own
+
+
+def msme_mean_tax(scale=1.0, c=None):
+    """Mean presumptive tax per household enterprise (ILFS 2024; self-employed in non-agricultural main jobs with turnover), turnover multiplied by `scale`."""
+    o = (c or cells())["all_owner"]
+    return float(np.mean(owner_tax(scale * np.array(o["turnover"]), scale * np.array(o["net_earnings"]))))
+
+
+def effective_rates(c=None):
+    """Effective average rates of the two means, for the record: mean tax / mean annual earnings of the group (net earnings for owners), and mean tax / mean turnover of the owners."""
+    c = c or cells()
+    non, own = c["informal_nonowner"], c["informal_owner"]
+    mean_earn = non["share"] * float(np.mean(non["annual_earnings"])) + own["share"] * float(np.mean(own["net_earnings"]))
+    it, mt = informal_mean_tax(c=c), msme_mean_tax(c=c)
+    mturn = float(np.mean(c["all_owner"]["turnover"]))
+    return {"informal_mean_tax_tzs": it, "informal_mean_earnings_tzs": mean_earn, "informal_effective_rate_on_earnings": it / mean_earn,
+            "msme_mean_tax_tzs": mt, "msme_mean_turnover_tzs": mturn, "msme_effective_rate_on_turnover": mt / mturn}
diff --git a/src/06_figures/_style.py b/src/06_figures/_style.py
--- /dev/null
+++ b/src/06_figures/_style.py
@@ -0,0 +1,60 @@
+"""Shared style and helpers of the figure scripts (Block F4).
+
+Every figure script in this folder (fig_<id>_<name>.py) defines make() and reads only the pipeline outputs (outputs/stats, outputs/tables, data/processed); it writes
+outputs/figures/fig_<id>_<name>.png and .svg. No figure number or title is drawn into an image (the report numbers and captions its figures). The files are deterministic
+(fixed fonts, no timestamps, fixed SVG hash salt), so run_all.py leaves identical bytes on a re-run.
+"""
+
+import json
+import os
+import sys
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths  # noqa: E402
+
+NAVY, GOLD, SLATE, CREAM = "#1B3A5C", "#96591A", "#44546A", "#F7F1E5"
+LIGHT = "#9FB1C7"
+GREY = "#8A8F98"
+RED = "#A23B3B"
+FIG_DIR = os.path.join(paths.ROOT, "outputs", "figures")
+
+plt.rcParams.update({
+    "font.family": "DejaVu Sans", "font.size": 10, "axes.spines.top": False, "axes.spines.right": False, "axes.edgecolor": SLATE, "axes.labelcolor": SLATE,
+    "xtick.color": SLATE, "ytick.color": SLATE, "axes.titlesize": 11, "figure.dpi": 100, "savefig.dpi": 200, "axes.grid": True, "grid.color": "#E5E7EB", "grid.linewidth": 0.6,
+    "axes.axisbelow": True, "svg.fonttype": "path", "svg.hashsalt": "tdj-figures", "legend.frameon": False,
+})
+
+
+def load_json(path):
+    with open(path, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def read_csv(path):
+    import csv
+    with open(path, encoding="utf-8-sig", newline="") as f:
+        return list(csv.DictReader(f))
+
+
+def save(fig, name):
+    """Writes outputs/figures/<name>.png and .svg (deterministic) and closes the figure; returns the two paths."""
+    os.makedirs(FIG_DIR, exist_ok=True)
+    out = []
+    for ext, meta in (("png", {"Software": None}), ("svg", {"Date": None, "Creator": None})):
+        p = os.path.join(FIG_DIR, "%s.%s" % (name, ext))
+        fig.savefig(p, format=ext, bbox_inches="tight", metadata=meta, facecolor="white")
+        out.append(p)
+    plt.close(fig)
+    return out
+
+
+def label_bars(ax, bars, fmt="{:.1f}", suffix="", dy=0.01):
+    top = ax.get_ylim()[1]
+    for b in bars:
+        h = b.get_height()
+        ax.text(b.get_x() + b.get_width() / 2, h + dy * top, (fmt + suffix).format(h), ha="center", va="bottom", color=SLATE, fontsize=9)
diff --git a/src/06_figures/capture_dashboard.py b/src/06_figures/capture_dashboard.py
--- /dev/null
+++ b/src/06_figures/capture_dashboard.py
@@ -0,0 +1,75 @@
+"""Dashboard screenshots (Block F4; opt-in: `python run_all.py --screenshots`).
+
+Starts the Streamlit dashboard headless on a free local port, opens each of the seven pages in headless Chromium (Playwright) at a fixed viewport, waits until the page has rendered and
+saves outputs/figures/dashboard_<page>.png. The server is stopped afterwards. Needs `pip install playwright` and `python -m playwright install chromium`
+(environment/requirements-screenshots.txt); nothing here runs without --screenshots. The screenshots are not byte-reproducible (browser rendering) and are not part of the idempotency check.
+"""
+
+import os
+import socket
+import subprocess
+import sys
+import time
+import urllib.request
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))  # src/
+import paths  # noqa: E402
+
+PAGES = [("home", ""), ("seed", "Seed"), ("entry", "Entry"), ("active", "Active"), ("enterprise", "Enterprise"), ("asset", "Asset"), ("legacy", "Legacy")]
+VIEWPORT = {"width": 1400, "height": 2800}
+
+
+def _free_port():
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def main():
+    try:
+        from playwright.sync_api import sync_playwright
+    except ImportError:
+        print("  screenshots skipped: Playwright is not installed (pip install -r environment/requirements-screenshots.txt; python -m playwright install chromium)")
+        return []
+    dash = os.path.join(paths.ROOT, "dashboard")
+    out_dir = os.path.join(paths.ROOT, "outputs", "figures")
+    os.makedirs(out_dir, exist_ok=True)
+    port = _free_port()
+    env = dict(os.environ, PYTHONIOENCODING="utf-8", PYTHONUTF8="1")
+    proc = subprocess.Popen([sys.executable, "-m", "streamlit", "run", os.path.join(dash, "Home.py"), "--server.headless", "true", "--server.port", str(port),
+                             "--browser.gatherUsageStats", "false", "--server.fileWatcherType", "none"], cwd=dash, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    written = []
+    try:
+        base = "http://127.0.0.1:%d" % port
+        for _ in range(120):
+            try:
+                urllib.request.urlopen(base + "/_stcore/health", timeout=2)
+                break
+            except Exception:
+                time.sleep(1)
+        else:
+            raise SystemExit("the dashboard did not start")
+        with sync_playwright() as p:
+            browser = p.chromium.launch()
+            page = browser.new_page(viewport=VIEWPORT, device_scale_factor=1)
+            for name, route in PAGES:
+                page.goto(base + "/" + route, wait_until="networkidle")
+                page.wait_for_selector('[data-testid="stAppViewContainer"]', timeout=60000)
+                page.wait_for_timeout(4000)                                   # let the charts and metrics finish rendering
+                path = os.path.join(out_dir, "dashboard_%s.png" % name)
+                page.screenshot(path=path, full_page=True)
+                written.append(path)
+            browser.close()
+    finally:
+        proc.terminate()
+        try:
+            proc.wait(timeout=20)
+        except Exception:
+            proc.kill()
+    print("  screenshots: %d dashboard pages written to outputs/figures" % len(written))
+    return written
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/06_figures/fig_5_1_modelled_compliance.py b/src/06_figures/fig_5_1_modelled_compliance.py
