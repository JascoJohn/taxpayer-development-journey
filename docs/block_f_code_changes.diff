@@ -0,0 +1,20 @@
+"""Targeting model variants: held-out weighted ROC-AUC of each feature set (outputs/tables/targeting_variants.csv)."""
+import textwrap
+
+import _style as S
+import matplotlib.pyplot as plt
+
+
+def make():
+    rows = sorted(S.read_csv(S.paths.TARGETING_VARIANTS_CSV), key=lambda r: float(r["roc_auc_weighted"]))
+    y = range(len(rows))
+    auc = [float(r["roc_auc_weighted"]) for r in rows]
+    fig, ax = plt.subplots(figsize=(9.2, 0.7 * len(rows) + 1.4))
+    bars = ax.barh(list(y), auc, color=[S.NAVY if r["model"].startswith("PRIMARY") else S.SLATE for r in rows], height=0.55)
+    ax.set_yticks(list(y))
+    ax.set_yticklabels([r["model"].split(":")[0] + ("\n" + "\n".join(textwrap.wrap(r["model"].split(":", 1)[1].strip(), 46)) if ":" in r["model"] else "") for r in rows], fontsize=7.5)
+    ax.set_xlim(0.5, 1.0)
+    ax.set_xlabel("Held-out ROC-AUC (survey-weighted); 0.5 = no skill")
+    for b, v, r in zip(bars, auc, rows):
+        ax.text(v + 0.004, b.get_y() + b.get_height() / 2, "%.3f  (%d features)" % (v, int(r["n_encoded_features"])), va="center", fontsize=8, color=S.SLATE)
+    return S.save(fig, "fig_a4_targeting_variants")
diff --git a/src/06_figures/fig_a5_macro_gap.py b/src/06_figures/fig_a5_macro_gap.py
--- /dev/null
+++ b/src/06_figures/fig_a5_macro_gap.py
@@ -0,0 +1,21 @@
+"""Macro gap: Tanzania's tax-to-GDP ratio against the peer countries (World Bank WDI) and the Ministry of Finance medium-term ratio (outputs/stats/macro_inputs.json)."""
+import _style as S
+import matplotlib.pyplot as plt
+
+
+def make():
+    m = S.load_json(S.paths.MACRO_INPUTS)
+    t, b, ctx = m["tanzania"], m["benchmark"], m["context_target"]
+    names = ["Tanzania\n(%d)" % t["latest_year"]] + ["%s\n(%d)" % (k, v["year"]) for k, v in sorted(b["peers"].items())] + ["Peer average\n(%d)" % b["year"]]
+    vals = [t["tax_to_gdp_pct"]] + [v["tax_to_gdp_pct"] for _, v in sorted(b["peers"].items())] + [b["benchmark_pct"]]
+    fig, ax = plt.subplots(figsize=(8.2, 4.4))
+    bars = ax.bar(range(len(vals)), vals, color=[S.NAVY] + [S.SLATE] * (len(vals) - 2) + [S.GOLD], width=0.6)
+    ax.axhline(ctx["tax_to_gdp_pct"], color=S.GREY, linestyle=":", linewidth=1.2, label="Ministry of Finance: %.1f%% in 2026/27 (context, not used in the gap)" % ctx["tax_to_gdp_pct"])
+    ax.set_xticks(range(len(vals)))
+    ax.set_xticklabels(names, fontsize=8)
+    ax.set_ylabel("Tax revenue (% of GDP)")
+    ax.set_ylim(0, max(vals) * 1.3)
+    S.label_bars(ax, bars, "{:.1f}", "%")
+    ax.legend(loc="upper left", fontsize=8)
+    fig.text(0.99, -0.03, "gap to the peer average: %.1f percentage points (World Bank WDI)" % abs(b["gap_pp"]), ha="right", fontsize=8, color=S.GREY)
+    return S.save(fig, "fig_a5_macro_gap")
diff --git a/src/06_figures/run_figures.py b/src/06_figures/run_figures.py
--- /dev/null
+++ b/src/06_figures/run_figures.py
@@ -0,0 +1,21 @@
+"""Runs every figure script of this folder (fig_*.py, in name order) and reports what was written. Called by run_all.py (step 10b); also runnable alone."""
+import importlib
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+
+def run_figures():
+    written = []
+    for f in sorted(os.listdir(HERE)):
+        if f.startswith("fig_") and f.endswith(".py"):
+            mod = importlib.import_module(f[:-3])
+            written += mod.make()
+    print("  figures: %d files written to outputs/figures (%d figures; PNG and SVG)" % (len(written), len(written) // 2))
+    return written
+
+
+if __name__ == "__main__":
+    run_figures()
