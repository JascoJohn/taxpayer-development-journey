+++ b/src/06_figures/fig_a2_tax_morale_components.py
@@ -0,0 +1,19 @@
+"""Tax-morale components, Afrobarometer Round 8 Tanzania, all adults 18+, survey-weighted with 95% confidence intervals (outputs/tables/tax_morale_components.csv)."""
+import _style as S
+import matplotlib.pyplot as plt
+
+
+def make():
+    rows = [r for r in S.read_csv(S.paths.TAX_MORALE_COMPONENTS_CSV) if r["level"] == "All adults 18+" and r["pct"] not in ("", None) and r["suppressed"] != "True"]
+    rows = sorted(rows, key=lambda r: float(r["pct"]))
+    y = range(len(rows))
+    v = [float(r["pct"]) for r in rows]
+    lo = [float(r["pct"]) - float(r["ci95_low_pct"]) for r in rows]
+    hi = [float(r["ci95_high_pct"]) - float(r["pct"]) for r in rows]
+    fig, ax = plt.subplots(figsize=(8.4, 0.34 * len(rows) + 1.4))
+    ax.barh(list(y), v, color=S.SLATE, height=0.6, xerr=[lo, hi], capsize=3, ecolor=S.GOLD)
+    ax.set_yticks(list(y))
+    ax.set_yticklabels([r["indicator"].replace("_", " ") for r in rows], fontsize=8)
+    ax.set_xlabel("Share of all adults 18+ (%)   estimate and 95% CI")
+    ax.set_xlim(0, 100)
+    return S.save(fig, "fig_a2_tax_morale_components")
diff --git a/src/06_figures/fig_a3_targeting_deciles.py b/src/06_figures/fig_a3_targeting_deciles.py
--- /dev/null
+++ b/src/06_figures/fig_a3_targeting_deciles.py
@@ -0,0 +1,23 @@
+"""Targeting model: observed TIN rate and mean predicted rate by decile of the predicted propensity (out-of-fold, survey-weighted; outputs/tables/targeting_deciles.csv)."""
+import _style as S
+import matplotlib.pyplot as plt
+
+
+def make():
+    rows = S.read_csv(S.paths.TARGETING_DECILES_CSV)
+    x = [int(r["decile"]) for r in rows]
+    obs = [float(r["observed_tin_rate_pct"]) if r["observed_tin_rate_pct"] else 0.0 for r in rows]
+    pred = [float(r["mean_predicted_pct"]) for r in rows]
+    fig, ax = plt.subplots(figsize=(8.4, 4.6))
+    bars = ax.bar(x, obs, color=S.SLATE, width=0.6, label="Observed TIN rate (survey-weighted)")
+    for b, r in zip(bars, rows):
+        if r["low_precision"] == "True":
+            b.set_hatch("//")
+            b.set_edgecolor("white")
+    ax.plot(x, pred, color=S.GOLD, marker="o", linewidth=2, label="Mean predicted rate (calibrated)")
+    ax.set_xticks(x)
+    ax.set_xlabel("Decile of predicted propensity (1 = highest ... 10 = lowest)")
+    ax.set_ylabel("Adults holding a TIN (%)")
+    ax.legend(loc="upper right", fontsize=8)
+    ax.text(0.99, 0.66, "hatched: low precision (fewer than 10 TIN holders);\ndeciles without a bar have no TIN holder in the sample", transform=ax.transAxes, ha="right", va="top", fontsize=7.5, color=S.GREY)
+    return S.save(fig, "fig_a3_targeting_deciles")
diff --git a/src/06_figures/fig_a4_targeting_variants.py b/src/06_figures/fig_a4_targeting_variants.py
