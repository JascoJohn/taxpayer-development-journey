diff --git a/src/03_features/survey_design.py b/src/03_features/survey_design.py
--- /dev/null
+++ b/src/03_features/survey_design.py
@@ -0,0 +1,72 @@
+"""Design-based (Taylor-linearised) standard errors and confidence intervals for weighted ratios.
+
+Used by tin_by_segment.py (FinScope) and ilfs_indicators.py (ILFS).
+
+Estimator: a (domain) ratio R = sum(w * num) / sum(w * den), e.g. the weighted share of TIN holders within a
+lifecycle stage (num = stage * TIN, den = stage). All observations stay in the data set when a domain is
+estimated (sub-population estimation), so the variance accounts for the random size of the domain.
+
+Variance (stratified one-stage cluster design, primary sampling units drawn with replacement):
+    z_i = w_i * (num_i - R * den_i) / sum(w * den)
+    z_hc = sum of z_i over the units of PSU c in stratum h
+    Var(R) = sum_h  n_h / (n_h - 1) * sum_c (z_hc - mean_h(z))^2
+The finite-population correction is ignored (sampling fractions are small). Strata with a single PSU
+cannot contribute a variance term; they are counted and reported, never silently dropped.
+
+Confidence interval: logit-transformed (the default of Stata's `svy: proportion`), Student-t with
+df = number of PSUs - number of strata; this keeps the interval inside 0-100% and handles rates near 0.
+"""
+
+import math
+
+import numpy as np
+import pandas as pd
+from scipy import stats
+
+
+def linearised_ratio(num, den, weights, strata, psu):
+    """Returns (ratio, standard error, n_psu, n_strata, n_lonely_strata) for sum(w*num)/sum(w*den).
+
+    num, den, weights: 1-D numeric arrays; strata, psu: 1-D label arrays (psu labels must be unique across
+    strata, build them with a composite key)."""
+    num = np.asarray(num, dtype=float)
+    den = np.asarray(den, dtype=float)
+    w = np.asarray(weights, dtype=float)
+    d_total = float((w * den).sum())
+    if d_total <= 0:
+        return float("nan"), float("nan"), 0, 0, 0
+    ratio = float((w * num).sum()) / d_total
+    z = w * (num - ratio * den) / d_total
+    frame = pd.DataFrame({"z": z, "h": np.asarray(strata), "c": np.asarray(psu)})
+    psu_totals = frame.groupby(["h", "c"], sort=False)["z"].sum().reset_index()
+    var = 0.0
+    lonely = 0
+    n_psu = len(psu_totals)
+    n_strata = psu_totals["h"].nunique()
+    for _, g in psu_totals.groupby("h", sort=False):
+        n_h = len(g)
+        if n_h < 2:
+            lonely += 1
+            continue
+        var += n_h / (n_h - 1.0) * float(((g["z"] - g["z"].mean()) ** 2).sum())
+    return ratio, math.sqrt(var), n_psu, n_strata, lonely
+
+
+def ci95(ratio, se, n_psu, n_strata):
+    """95% confidence interval for a proportion in [0, 1]: logit scale, Student-t. Returns (low, high) in [0, 1].
+    Falls back to the (truncated) normal interval when the ratio is 0 or 1 or the se is 0."""
+    if not (ratio == ratio) or not (se == se):
+        return float("nan"), float("nan")
+    df = max(n_psu - n_strata, 1)
+    t = float(stats.t.ppf(0.975, df))
+    if 0.0 < ratio < 1.0 and se > 0:
+        se_logit = se / (ratio * (1.0 - ratio))
+        centre = math.log(ratio / (1.0 - ratio))
+        lo = centre - t * se_logit
+        hi = centre + t * se_logit
+        return 1.0 / (1.0 + math.exp(-lo)), 1.0 / (1.0 + math.exp(-hi))
+    return max(ratio - t * se, 0.0), min(ratio + t * se, 1.0)
+
+
+def design_df(n_psu, n_strata):
+    return max(n_psu - n_strata, 1)
diff --git a/src/03_features/tax_exemptions.py b/src/03_features/tax_exemptions.py
--- /dev/null
+++ b/src/03_features/tax_exemptions.py
@@ -0,0 +1,176 @@
+"""W2 - tax exemption and relief rates from the Ministry of Finance workbook.
+
+Reads data/raw/tax_exemptions/<MoF workbook>.XLSX (sheet 'Summary') with openpyxl. Cells are located by their
+header labels and row labels, never by fixed row or column numbers:
+
+  * measure groups (header row): 'Exemption and Relief (Million)', 'Departmental Actual Gross Collection (Million)',
+    'Exemption as % of Actual Gross collection.'
+  * periods (row below the groups): '2023/24 - Q1', '2022/23 - Q1'
+  * row blocks (label column found by its 'Domestic Reliefs' cell): 'Domestic Reliefs', 'Customs and Excise', 'Total';
+    each block's own 'Subtotal' row.
+
+Extracted for Q1 2023/24 (July-September 2023; ONE QUARTER, not a full year): the total rate, the domestic rate and the
+customs/excise rate, each with the exemption and collection amounts (million TZS) and the workbook's own ratio;
+plus the workbook's own Q1 2022/23 total for context. Every value carries its source sheet and cell reference.
+The rate is recomputed from the two amounts and compared with the workbook's own ratio cell.
+
+Output: outputs/stats/tax_exemption_rate.json
+"""
+
+import json
+import os
+import re
+import sys
+import warnings
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths
+
+SHEET = "Summary"
+PERIOD = "2023/24 - Q1"
+PERIOD_PRIOR = "2022/23 - Q1"
+GROUP_LABELS = {
+    "exemption": "exemption and relief",
+    "collection": "actual gross collection",
+    "rate": "exemption as % of actual gross collection",
+}
+BLOCKS = {"domestic": "domestic reliefs", "customs_excise": "customs and excise", "total": "total"}
+QUARTER_NOTE = ("Single quarter (Q1 2023/24 = July-September 2023), not an annual rate. The total is dominated by "
+                "customs and excise; domestic reliefs are the part that applies to the domestic compliance funnel.")
+
+
+def _norm(v):
+    return re.sub(r"\s+", " ", str(v)).strip().lower() if v is not None else ""
+
+
+def _locate(ws):
+    """Finds the (column, row) of every needed cell by labels. Returns (cols, rows, header_rows)."""
+    # header rows: the row holding the measure-group labels, and the row below it holding the periods
+    group_row = None
+    for row in ws.iter_rows():
+        labels = {_norm(c.value) for c in row if c.value is not None}
+        if any(g in lbl for lbl in labels for g in GROUP_LABELS.values()):
+            group_row = row[0].row
+            break
+    if group_row is None:
+        raise ValueError("measure-group header row not found on sheet %s" % SHEET)
+    period_row = group_row + 1
+
+    # a measure group spans from its own cell to the next group label (merged cells keep only the first value)
+    group_by_col, current = {}, None
+    for c in ws[group_row]:
+        lbl = _norm(c.value)
+        if lbl:
+            # the rate label contains the collection label, so test the most specific label first
+            current = next((k for k in ("rate", "exemption", "collection") if GROUP_LABELS[k] in lbl), None)
+        if current:
+            group_by_col[c.column] = current
+    cols = {}
+    for c in ws[period_row]:
+        per = _norm(c.value)
+        g = group_by_col.get(c.column)
+        if g and per:
+            cols[(g, per)] = c.column
+
+    # label columns: the column holding the 'Domestic Reliefs' block label, and the one next to it (sub-lines)
+    label_col = None
+    for row in ws.iter_rows(min_row=period_row + 1):
+        for c in row:
+            if _norm(c.value) == BLOCKS["domestic"]:
+                label_col = c.column
+                break
+        if label_col:
+            break
+    if label_col is None:
+        raise ValueError("block label %r not found on sheet %s" % (BLOCKS["domestic"], SHEET))
+
+    # rows: block label (carried down), 'Subtotal' belongs to the block above it
+    rows, block = {}, None
+    for r in range(period_row + 1, ws.max_row + 1):
+        a, b = _norm(ws.cell(r, label_col).value), _norm(ws.cell(r, label_col + 1).value)
+        if a in ("subtotal",):
+            if block:
+                rows[block + ":subtotal"] = r
+        elif a == "total":
+            rows["total"] = r
+        elif a:
+            block = a
+        if b:
+            rows[(block or "") + ":" + b] = r
+    return cols, rows, (group_row, period_row)
+
+
+def _cell(ws, rows, cols, row_key, measure, period):
+    col = cols[(measure, _norm(period))]
+    r = rows[row_key]
+    c = ws.cell(r, col)
+    return {"value": float(c.value), "sheet": ws.title, "cell": c.coordinate}
+
+
+def extract(xlsx_path):
+    from openpyxl import load_workbook
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")           # openpyxl: unparseable header/footer in this workbook
+        wb = load_workbook(xlsx_path, data_only=True)
+    ws = wb[SHEET]
+    cols, rows, header_rows = _locate(ws)
+    keyrow = {"domestic": "domestic reliefs:subtotal", "customs_excise": "customs and excise:subtotal", "total": "total"}
+    parts = {}
+    for name, rk in keyrow.items():
+        ex = _cell(ws, rows, cols, rk, "exemption", PERIOD)
+        co = _cell(ws, rows, cols, rk, "collection", PERIOD)
+        rt = _cell(ws, rows, cols, rk, "rate", PERIOD)
+        recomputed = ex["value"] / co["value"]
+        if abs(recomputed - rt["value"]) > 1e-9:
+            raise ValueError("%s: workbook ratio %.10f differs from exemption/collection %.10f" % (name, rt["value"], recomputed))
+        parts[name] = {
+            "exemption_million_tzs": ex, "gross_collection_million_tzs": co, "workbook_ratio": rt,
+            "rate_pct": rt["value"] * 100.0, "rate_pct_recomputed": recomputed * 100.0,
+        }
+    # sub-lines of the domestic block, for context
+    sub = {}
+    for label, rk in (("large_taxpayers_ltd", "domestic reliefs:large taxpayers (ltd)"), ("other_taxpayers_drd", "domestic reliefs:other taxpayers (drd)"),
+                      ("mainland", "customs and excise:mainland"), ("zanzibar", "customs and excise:zanzibar")):
+        if rk in rows:
+            sub[label] = {"rate_pct": _cell(ws, rows, cols, rk, "rate", PERIOD)["value"] * 100.0,
+                          "cell": _cell(ws, rows, cols, rk, "rate", PERIOD)["cell"]}
+    prior = {
+        "period": PERIOD_PRIOR,
+        "total_rate_pct": _cell(ws, rows, cols, "total", "rate", PERIOD_PRIOR)["value"] * 100.0,
+        "total_rate_cell": _cell(ws, rows, cols, "total", "rate", PERIOD_PRIOR)["cell"],
+        "domestic_rate_pct": _cell(ws, rows, cols, "domestic reliefs:subtotal", "rate", PERIOD_PRIOR)["value"] * 100.0,
+        "customs_excise_rate_pct": _cell(ws, rows, cols, "customs and excise:subtotal", "rate", PERIOD_PRIOR)["value"] * 100.0,
+    }
+    return {
+        "source_file": os.path.basename(xlsx_path),
+        "sheet": SHEET,
+        "period": PERIOD,
+        "period_note": QUARTER_NOTE,
+        "header_rows_found": {"measure_groups": header_rows[0], "periods": header_rows[1]},
+        "components": parts,
+        "domestic_sub_lines_pct": sub,
+        "prior_year_same_quarter": prior,
+        "funnel_rate": "domestic",
+        "funnel_rate_pct": parts["domestic"]["rate_pct"],
+        "sensitivity_rate": "total",
+        "sensitivity_rate_pct": parts["total"]["rate_pct"],
+        "previous_typed_constant_pct": 8.77,
+    }
+
+
+def run_tax_exemptions(xlsx_path=None, out_path=None):
+    xlsx_path = xlsx_path or paths.TAX_EXEMPTIONS_XLSX
+    out_path = out_path or paths.TAX_EXEMPTION_RATE
+    result = extract(xlsx_path)
+    os.makedirs(os.path.dirname(out_path), exist_ok=True)
+    with open(out_path, "w", encoding="utf-8") as f:
+        json.dump(result, f, indent=2, ensure_ascii=False)
+    c = result["components"]
+    print("  %s: total %.4f%% | domestic %.4f%% | customs/excise %.4f%%  (Q1 2022/23 total %.4f%%)" % (
+        PERIOD, c["total"]["rate_pct"], c["domestic"]["rate_pct"], c["customs_excise"]["rate_pct"],
+        result["prior_year_same_quarter"]["total_rate_pct"]))
+    return result
+
+
+if __name__ == "__main__":
+    run_tax_exemptions()
diff --git a/src/03_features/tin_by_segment.py b/src/03_features/tin_by_segment.py
--- /dev/null
+++ b/src/03_features/tin_by_segment.py
@@ -0,0 +1,181 @@
+"""W5 - TIN holding by lifecycle stage, from ONE stratification and ONE weight.
+
+Reads FinScope Tanzania 2023 (data/raw/finscope/FinScope.csv) and computes, overall and for each of the five
+adult stages (Entry, Active, Enterprise, Asset, Legacy):
+
+  * the weighted TIN rate (c27__13 = 'Yes', weight population_wt),
+  * the unweighted n and the unweighted number of TIN holders,
+  * the weighted population and TIN holders,
+  * design-based (Taylor-linearised) 95% confidence intervals (see survey_design.py).
+
+The stage assignment, the weight and the TIN mask are the single definitions in finscope_segments.py.
+The five stages are mutually exclusive and exhaustive for respondents aged 16+, so the population-weighted
+average of the stage rates equals the overall rate by construction; this script checks it in code and
+raises ReconciliationError if it does not hold.
+
+Survey design: FinScope.csv has no variable called strata, psu or cluster. It does carry the sampling-frame
+geography: region (reg_code), urban/rural cluster type (clustertype), district, ward and enumeration-area codes.
+Enumeration-area codes are only unique within a ward, so the primary sampling unit is rebuilt as the composite
+reg_code | dist_code | ward_code1 | ea_code (666 EAs, 15 respondents each in all but a few), and strata as
+region x cluster type (61 strata, 2-35 PSUs each). This is a RECONSTRUCTED design (FSDT does not document it in the
+files held), so the confidence intervals are labelled "reconstructed design" wherever they are shown.
+
+Outputs: outputs/tables/tin_by_segment.csv, outputs/stats/tin_reconciliation.json.
+"""
+
+import csv
+import json
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths
+from finscope_segments import (ADULT_STAGES, SEED_AGE_MAX, SEED_AGE_MIN, WEIGHT_VAR, lifecycle_stage,
+                               survey_weights, tin_holder_mask)
+from survey_design import ci95, design_df, linearised_ratio
+
+STAGE_LABELS = {"entry": "Entry", "active": "Active", "enterprise": "Enterprise", "asset": "Asset", "legacy": "Legacy"}
+STAGE_DEFINITIONS = {
+    "entry": "age %d-24" % (SEED_AGE_MAX + 1),
+    "active": "age 25-44, not a business owner (BusO != 'Business owners')",
+    "enterprise": "age 25-64, business owner (BusO == 'Business owners')",
+    "asset": "age 45-64, not a business owner",
+    "legacy": "age 65+",
+}
+TOLERANCE = 1e-9          # the identity is exact up to floating-point error
+DESIGN_COLUMNS = ["reg_code", "dist_code", "ward_code1", "ea_code", "clustertype"]
+
+# values quoted in the submitted report (rounded, per cent) - compared in the reconciliation file
+REPORT_VALUES_PCT = {"overall": 3.8, "active": 4.6, "enterprise": 9.7}
+
+
+class ReconciliationError(RuntimeError):
+    """The population-weighted average of the stage TIN rates differs from the overall rate."""
+
+
+def reconstruct_design(df):
+    """(strata, psu, description) from the sampling-frame columns; (None, None, text) if they are missing."""
+    missing = [c for c in DESIGN_COLUMNS if c not in df.columns]
+    if missing:
+        return None, None, "design variables missing (%s): weighted rates and unweighted n only" % ", ".join(missing)
+    psu = df[["reg_code", "dist_code", "ward_code1", "ea_code"]].astype(str).agg("|".join, axis=1)
+    strata = df["reg_code"].astype(str) + "|" + df["clustertype"].astype(str)
+    return strata, psu, ("RECONSTRUCTED design: PSU = enumeration area (reg_code|dist_code|ward_code1|ea_code), "
+                         "strata = region x urban/rural cluster type (reg_code|clustertype); "
+                         "linearised variance, logit CI, Student-t")
+
+
+def _row(name, label, definition, mask, tin, w, n_total_w, strata, psu):
+    n = int(mask.sum())
+    n_tin = int((mask & tin).sum())
+    pop = float(w[mask].sum())
+    tin_w = float(w[mask & tin].sum())
+    rate = tin_w / pop if pop > 0 else float("nan")
+    row = {"segment": name, "label": label, "definition": definition, "n_unweighted": n,
+           "tin_holders_unweighted": n_tin, "population_weighted": pop,
+           "population_share_pct": pop / n_total_w * 100.0, "tin_holders_weighted": tin_w,
+           "tin_rate_pct": rate * 100.0, "se_pct": None, "ci95_low_pct": None, "ci95_high_pct": None}
+    if strata is not None:
+        num = (mask & tin).to_numpy(dtype=float)
+        den = mask.to_numpy(dtype=float)
+        r, se, n_psu, n_str, lonely = linearised_ratio(num, den, w.to_numpy(), strata.to_numpy(), psu.to_numpy())
+        lo, hi = ci95(r, se, n_psu, n_str)
+        row.update(se_pct=se * 100.0, ci95_low_pct=lo * 100.0, ci95_high_pct=hi * 100.0)
+        row["_design"] = (n_psu, n_str, lonely)
+    return row
+
+
+def compute(df):
+    """Returns (rows, reconciliation dict) for a FinScope data frame."""
+    w = survey_weights(df)
+    tin = tin_holder_mask(df)
+    stage = pd.Series(lifecycle_stage(df), index=df.index)
+    total_w = float(w.sum())
+    strata, psu, design_text = reconstruct_design(df)
+
+    rows = [_row("overall", "All adults (16+)", "every respondent", pd.Series(True, index=df.index), tin, w, total_w, strata, psu)]
+    for s in ADULT_STAGES:
+        rows.append(_row(s, STAGE_LABELS[s], STAGE_DEFINITIONS[s], stage == s, tin, w, total_w, strata, psu))
+    unassigned = ~stage.isin(ADULT_STAGES)
+    if unassigned.any():
+        rows.append(_row("unassigned", "Not in an adult stage", "age outside the adult stages", unassigned, tin, w, total_w, strata, psu))
+
+    stage_rows = [r for r in rows if r["segment"] != "overall"]
+    overall = rows[0]
+    avg = sum(r["population_weighted"] / total_w * r["tin_rate_pct"] for r in stage_rows if r["population_weighted"] > 0)
+    diff = avg - overall["tin_rate_pct"]
+    rec = {
+        "identity": "sum over stages of (stage population / total population) x stage TIN rate = overall TIN rate",
+        "weight_variable": WEIGHT_VAR,
+        "tin_variable": "c27__13 == 'Yes'",
+        "stage_assignment": "finscope_segments.lifecycle_stage (single definition); seed band %d-%d (config.yaml seed_age_band)" % (SEED_AGE_MIN, SEED_AGE_MAX),
+        "n_respondents": int(len(df)),
+        "weighted_population": total_w,
+        "overall_tin_rate_pct": overall["tin_rate_pct"],
+        "population_weighted_average_of_stage_rates_pct": avg,
+        "difference_pct_points": diff,
+        "tolerance_pct_points": TOLERANCE,
+        "identity_holds": bool(abs(diff) <= TOLERANCE),
+        "unassigned_respondents": int(unassigned.sum()),
+        "weights_sum_equal_across_stages": bool(abs(sum(r["population_weighted"] for r in stage_rows) - total_w) < 1e-6),
+        "stage_rates_pct": {r["segment"]: r["tin_rate_pct"] for r in stage_rows},
+        "stage_population_share_pct": {r["segment"]: r["population_share_pct"] for r in stage_rows},
+        "design": design_text,
+    }
+    if strata is not None:
+        n_psu, n_str, lonely = overall["_design"]
+        rec["design_summary"] = {"n_psu": n_psu, "n_strata": n_str, "strata_with_one_psu": lonely,
+                                 "degrees_of_freedom": design_df(n_psu, n_str)}
+    else:
+        rec["design_summary"] = None
+    if not rec["identity_holds"] or rec["unassigned_respondents"] or not rec["weights_sum_equal_across_stages"]:
+        raise ReconciliationError(
+            "TIN reconciliation failed: weighted average of stage rates %.12f%% vs overall %.12f%% (difference %.3e); "
+            "unassigned respondents: %d" % (avg, overall["tin_rate_pct"], diff, rec["unassigned_respondents"]))
+    rec["report_values_pct"] = {
+        k: {"report": v, "computed_rounded_1dp": round((overall if k == "overall" else next(r for r in rows if r["segment"] == k))["tin_rate_pct"], 1)}
+        for k, v in REPORT_VALUES_PCT.items()}
+    return rows, rec
+
+
+def write_outputs(rows, rec, table_path, json_path):
+    os.makedirs(os.path.dirname(table_path), exist_ok=True)
+    os.makedirs(os.path.dirname(json_path), exist_ok=True)
+    cols = ["segment", "label", "definition", "n_unweighted", "tin_holders_unweighted", "population_weighted",
+            "population_share_pct", "tin_holders_weighted", "tin_rate_pct", "se_pct", "ci95_low_pct", "ci95_high_pct"]
+    with open(table_path, "w", encoding="utf-8", newline="") as f:
+        wr = csv.writer(f, lineterminator="\n")
+        wr.writerow(cols)
+        for r in rows:
+            out = []
+            for c in cols:
+                v = r[c]
+                if isinstance(v, float):
+                    v = "%.4f" % v if c.endswith("_pct") else "%.2f" % v
+                out.append("" if v is None else v)
+            wr.writerow(out)
+    rec = dict(rec)
+    rec["table"] = paths.CFG["files"]["tin_by_segment_csv"]
+    with open(json_path, "w", encoding="utf-8") as f:
+        json.dump(rec, f, indent=2, ensure_ascii=False)
+
+
+def run_tin_by_segment(csv_path=None, table_path=None, json_path=None):
+    csv_path = csv_path or paths.FINSCOPE_CSV
+    table_path = table_path or paths.TIN_BY_SEGMENT_CSV
+    json_path = json_path or paths.TIN_RECONCILIATION
+    df = pd.read_csv(csv_path, low_memory=False)
+    rows, rec = compute(df)
+    write_outputs(rows, rec, table_path, json_path)
+    print("  overall TIN rate %.3f%%; identity holds (difference %.2e pp)" % (rec["overall_tin_rate_pct"], rec["difference_pct_points"]))
+    for r in rows:
+        ci = "" if r["ci95_low_pct"] is None else "  95%% CI %.2f-%.2f" % (r["ci95_low_pct"], r["ci95_high_pct"])
+        print("  %-10s n=%5d  TIN holders=%4d  rate %.3f%%%s" % (r["segment"], r["n_unweighted"], r["tin_holders_unweighted"], r["tin_rate_pct"], ci))
+    return rec
+
+
+if __name__ == "__main__":
+    run_tin_by_segment()
