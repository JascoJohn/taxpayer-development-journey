diff --git a/src/01_ingest/fetch_worldbank.py b/src/01_ingest/fetch_worldbank.py
--- /dev/null
+++ b/src/01_ingest/fetch_worldbank.py
@@ -0,0 +1,85 @@
+"""World Bank WDI snapshot fetcher: the ONLY code in this project that calls the network.
+
+Called only by `run_all.py --fetch`. For every series listed under `worldbank.series` in config.yaml it requests all
+available years from the WDI API v2, saves the RAW response unchanged to
+    data/raw/worldbank/<indicator>_<YYYY-MM-DD>.json
+and appends one row (URL, retrieval timestamp, SHA-256, size) to data/raw/worldbank/MANIFEST.csv.
+Nothing is parsed or altered here. The analysis (macro_inputs.py) reads the snapshots named under `worldbank.snapshots`
+in config.yaml; after a fetch, copy the new file names into that block to adopt them.
+
+WDI data are licensed CC BY 4.0 (attribute: World Bank, World Development Indicators).
+"""
+
+import csv
+import datetime
+import hashlib
+import os
+import sys
+import time
+import urllib.request
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths
+
+TIMEOUT_SECONDS = 60
+ATTEMPTS = 4
+MANIFEST_COLUMNS = ["indicator", "countries", "years", "file", "url", "retrieved_at", "sha256", "bytes"]
+
+
+def series_url(indicator, countries, years):
+    base = paths.WB_CFG["api_base"].rstrip("/")
+    return "%s/country/%s/indicator/%s?format=json&per_page=20000&date=%s" % (base, ";".join(countries), indicator, years)
+
+
+def fetch_series(indicator, countries, years, today=None):
+    """Download one series and save the raw bytes. Returns the manifest row (dict)."""
+    url = series_url(indicator, countries, years)
+    req = urllib.request.Request(url, headers={"User-Agent": "tdj-pipeline/1.0"})
+    body = None
+    for attempt in range(1, ATTEMPTS + 1):          # the WDI gateway answers 502 / times out now and then
+        try:
+            with urllib.request.urlopen(req, timeout=TIMEOUT_SECONDS) as resp:
+                body = resp.read()
+            if body[:1] == b"[":
+                break
+            raise ValueError("response is not a JSON array")
+        except Exception as e:
+            print("    attempt %d/%d failed for %s: %s" % (attempt, ATTEMPTS, indicator, e))
+            if attempt == ATTEMPTS:
+                raise
+            time.sleep(10)
+    stamp = (today or datetime.date.today()).isoformat()
+    os.makedirs(paths.WB_SNAPSHOT_DIR, exist_ok=True)
+    fname = "%s_%s.json" % (indicator, stamp)
+    with open(os.path.join(paths.WB_SNAPSHOT_DIR, fname), "wb") as f:      # unchanged bytes
+        f.write(body)
+    return {"indicator": indicator, "countries": ";".join(countries), "years": years, "file": fname, "url": url,
+            "retrieved_at": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
+            "sha256": hashlib.sha256(body).hexdigest(), "bytes": len(body)}
+
+
+def append_manifest(row):
+    new = not os.path.exists(paths.WB_MANIFEST)
+    with open(paths.WB_MANIFEST, "a", encoding="utf-8", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=MANIFEST_COLUMNS, lineterminator="\n")
+        if new:
+            w.writeheader()
+        w.writerow(row)
+
+
+def fetch_all():
+    """Fetch every configured series. Returns the list of manifest rows."""
+    rows = []
+    years = paths.WB_CFG["years"]
+    for s in paths.WB_CFG["series"]:
+        row = fetch_series(s["indicator"], s["countries"], years)
+        append_manifest(row)
+        rows.append(row)
+        print("  %-18s %-22s %7d bytes  sha256 %s...  -> %s" % (row["indicator"], row["countries"], row["bytes"], row["sha256"][:12], row["file"]))
+    print("  Manifest: %s. To adopt these snapshots set worldbank.snapshots in config.yaml to the file names above." %
+          os.path.relpath(paths.WB_MANIFEST, paths.ROOT))
+    return rows
+
+
+if __name__ == "__main__":
+    fetch_all()
diff --git a/src/03_features/macro_inputs.py b/src/03_features/macro_inputs.py
--- /dev/null
+++ b/src/03_features/macro_inputs.py
@@ -0,0 +1,148 @@
+"""W3 - macro inputs from the World Bank WDI snapshots (no network access: reads the files named in config.yaml).
+
+Reads the snapshots under `worldbank.snapshots`:
+  GC.TAX.TOTL.GD.ZS  tax revenue, % of GDP (Tanzania and the four peers GHA, KEN, RWA, UGA)
+  NY.GDP.MKTP.CN     GDP, current LCU (TZS), Tanzania
+  NY.GDP.MKTP.CD     GDP, current US$, Tanzania (reported only where a US$ figure is shown)
+  PA.NUS.FCRF        official exchange rate, LCU per US$, period average (US$ equivalents only)
+
+Computes (all COMPUTED, nothing typed):
+  * Tanzania's latest tax-to-GDP ratio (latest year with a value);
+  * the benchmark year: the latest year in which Tanzania AND all four peers report;
+  * the peer-average benchmark: the simple mean of the four peers in that year;
+  * the revenue gap in TZS = (benchmark - Tanzania in the SAME year) x GDP in TZS of that year (no exchange-rate step);
+  * US$ equivalents, converting with PA.NUS.FCRF of the same year.
+
+Benchmark policy (config.yaml macro.benchmark_source): `peer_average` (default) or `cited_target` (a published Tanzanian
+target; none is adopted yet, so selecting it without `macro.cited_target_pct` and `macro.cited_target_source` stops the
+run). With a cited target there is no common year: the gap uses the cited ratio and Tanzania's ratio in its latest year.
+
+Output: outputs/stats/macro_inputs.json
+"""
+
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))  # src/
+import paths
+
+TAX = "GC.TAX.TOTL.GD.ZS"
+GDP_LCU = "NY.GDP.MKTP.CN"
+GDP_USD = "NY.GDP.MKTP.CD"
+FX = "PA.NUS.FCRF"
+
+
+def load_series(path):
+    """{ISO3: {year: value}} from a raw WDI v2 response (null values skipped); also returns the file's lastupdated."""
+    with open(path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+    meta, rows = data[0], data[1]
+    out = {}
+    for r in rows:
+        if r.get("value") is None:
+            continue
+        out.setdefault(r["countryiso3code"], {})[int(r["date"])] = float(r["value"])
+    return out, meta.get("lastupdated")
+
+
+def load_snapshots(snapshots=None):
+    snapshots = snapshots or paths.WB_SNAPSHOTS
+    series, updated = {}, {}
+    for ind in (TAX, GDP_LCU, GDP_USD, FX):
+        if ind not in snapshots:
+            raise KeyError("worldbank.snapshots in config.yaml has no entry for %s" % ind)
+        if not os.path.exists(snapshots[ind]):
+            raise FileNotFoundError("%s not found: run `python run_all.py --fetch` once, then name the snapshot in config.yaml" % snapshots[ind])
+        series[ind], updated[ind] = load_series(snapshots[ind])
+    return series, updated
+
+
+def compute(series, country, peers, benchmark_source="peer_average", cited_target_pct=None, cited_target_source=None):
+    tax = series[TAX]
+    tza = tax[country]
+    latest_year = max(tza)
+    common = [y for y in tza if all(y in tax.get(p, {}) for p in peers)]
+    if not common:
+        raise ValueError("no year in which %s and all peers report %s" % (country, TAX))
+    bench_year = max(common)
+    peer_vals = {p: tax[p][bench_year] for p in peers}
+    peer_avg = sum(peer_vals.values()) / len(peer_vals)
+
+    gdp_lcu, gdp_usd, fx = series[GDP_LCU][country], series[GDP_USD][country], series[FX][country]
+
+    if benchmark_source == "peer_average":
+        gap_year = bench_year
+        benchmark_pct = peer_avg
+        benchmark_note = "simple mean of %s in %d (latest year all five countries report)" % (", ".join(peers), bench_year)
