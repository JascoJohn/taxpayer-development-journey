+  snapshots:                      # the snapshot the analysis reads, per indicator (set after a --fetch)
+    GC.TAX.TOTL.GD.ZS: data/raw/worldbank/GC.TAX.TOTL.GD.ZS_2026-11-12.json
+    NY.GDP.MKTP.CN: data/raw/worldbank/NY.GDP.MKTP.CN_2026-11-12.json
+    NY.GDP.MKTP.CD: data/raw/worldbank/NY.GDP.MKTP.CD_2026-11-12.json
