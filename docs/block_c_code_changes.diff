+# ============================================================
+# LEDGER FROM THE config.yaml `assumptions:` BLOCK (Block C, W12)
+# ============================================================
+_GROUP_CATEGORY = {"morale": "behavioral", "tier": "behavioral", "twin": "economic", "cost": "economic",
+                   "seg": "technical", "causal": "technical", "macro": "economic"}
+_BASIS_CONFIDENCE = {"DATA": "HIGH", "LITERATURE": "MEDIUM", "ASSUMPTION": "MEDIUM", "UNKNOWN": "LOW"}
+
+
+def _load_sensitivity():
+    """Sensitivity results written by src/tools/assumption_sensitivity.py (docs/assumption_sensitivity.json), if present."""
+    try:
+        with open(paths.ASSUMPTION_SENSITIVITY, "r", encoding="utf-8") as f:
+            return json.load(f).get("results", {})
+    except (FileNotFoundError, json.JSONDecodeError):
+        return {}
+
+
+def write_config_ledger():
+    """Writes one ledger entry per constant of the `assumptions:` block into assumption_ledger.json.
+
+    Ids are stable: ASS- + first 8 hex characters of SHA-1(key) (assumptions.assumption_id). Entries that came from the
+    config block are replaced on every run (the entries logged by log_assumption() are kept), so the file does not grow."""
+    import assumptions
+    sens = _load_sensitivity()
+    if os.path.exists(LEDGER_FILE):
+        with open(LEDGER_FILE, "r", encoding="utf-8") as f:
+            ledger = json.load(f)
+    else:
+        ledger = {"total": 0, "assumptions": []}
+    kept = [a for a in ledger.get("assumptions", []) if "key" not in a]
+    entries = []
+    for key in sorted(assumptions.keys()):
+        e = assumptions.entry(key)
+        s = sens.get(key)
+        value = e.get("value")
+        entries.append({
+            "assumption_id": assumptions.assumption_id(key),
+            "key": key,
+            "assumption_text": "%s = %s: %s" % (key, json.dumps(value) if "value" in e else "read from " + str(e.get("from")), e.get("source", "")),
+            "made_by_agent": "config.yaml assumptions",
+            "category": _GROUP_CATEGORY.get(e.get("group"), "technical"),
+            "confidence": _BASIS_CONFIDENCE.get(e.get("basis"), "LOW"),
+            "evidence_support": e.get("source"),
+            "stress_tested": s is not None,
+            "stress_test_result": s,
+            "section_reference": e.get("feeds"),
+            "basis": e.get("basis"),
+            "value": value,
+            "feeds": e.get("feeds"),
+            "group": e.get("group"),
+        })
+    ledger["assumptions"] = kept + entries
+    ledger["total"] = len(ledger["assumptions"])
+    with open(LEDGER_FILE, "w", encoding="utf-8") as f:
+        json.dump(ledger, f, indent=2, ensure_ascii=False)
+    return ledger
 
 
