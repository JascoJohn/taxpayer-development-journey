+# Project configuration - The Taxpayer Development Journey (Behavioral)
+# All paths are relative to the project root (the folder holding this file) and use "/".
+# src/paths.py reads this file; no script uses the working directory.
+
+project:
+  name: taxpayer-development-journey
+  title: "The Taxpayer Development Journey: A Behavioral Architecture for Tax Compliance"
+
+# Seeds and simulation sizes. Values are those hard-coded in the original scripts
+# (economic_model.py, finscope_targeting_population_loader.py, run_all.py).
+simulation:
+  random_seed: 42      # economic_model.RANDOM_SEED; targeting loader uses the same value (+2, +4 offsets in code)
+  n_agents: 500000     # agent-based and tier-migration simulations
+  n_years: 10          # simulation horizon in years
+
+# Every file the pipeline reads or writes.
+files:
+  # raw inputs
+  finscope_csv:        data/raw/finscope/FinScope.csv
+  finscope_datamap:    data/raw/finscope/FinScope Datamap.xlsx
+  # interim
+  finscope_summary:        data/interim/finscope_summary.json
+  finscope_feature_store:  data/interim/finscope_feature_store.json
+  shared_context:          data/interim/shared_context.json
+  # processed
+  finscope_region_activity:  data/processed/finscope_region_activity.json
+  finscope_active_benchmark: data/processed/finscope_active_benchmark.json
+  # outputs
+  economic_model:              outputs/stats/economic_model.json
+  finscope_report:             outputs/stats/finscope_report.txt
+  finscope_targeting_population: outputs/stats/finscope_targeting_population.json
+  intervention_register:       outputs/stats/intervention_register.json
+  assumption_ledger:           outputs/stats/assumption_ledger.json
+  assumption_ledger_report:    outputs/stats/assumption_ledger_report.txt
+  assumption_ledger_summary:   outputs/stats/assumption_ledger_summary.json
+  audit_trail:                 outputs/stats/audit_trail.json
+  # frozen: LLM-generated report sections carried over unchanged (not regenerated by this project)
+  report_sections:             outputs/frozen/report_sections.json

