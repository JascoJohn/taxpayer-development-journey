# Byte-compiled / cache
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# Secrets (key names only go in .env.example)
.env
.env.*
!.env.example

# Superseded material kept locally, never published
_archive/

# OS cruft
.DS_Store
Thumbs.db

# Raw data: NBS and FSDT terms forbid redistribution (see docs/data_terms.md and data/raw/SOURCES.csv).
# Only the provenance file and READMEs in data/raw/ are tracked.
data/raw/**
!data/raw/*/
!data/raw/SOURCES.csv
!data/raw/README*
!data/raw/*/README*
# World Bank WDI snapshots are CC BY 4.0: tracked
!data/raw/worldbank/**

# Private working material: never published (Publishing prep, 2026-11-15)
# Everything under report/ is private except report/final/ (earlier versions, working copies, source parts)
report/*
!report/final/
!report/final/**

# Local staging, archives and build output
_publish_staging/
*.zip
*.tar
*.tar.gz
*.bak

data/interim/targeting_bootstrap/
